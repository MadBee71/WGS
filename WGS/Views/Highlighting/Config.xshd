<?xml version="1.0"?>
<SyntaxDefinition name="Config" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6A9955"/>
  <Color name="String"  foreground="#CE9178"/>
  <Color name="Number"  foreground="#B5CEA8"/>
  <Color name="Key"     foreground="#9CDCFE"/>
  <Color name="Section" foreground="#DCDCAA" fontWeight="bold"/>
  <Color name="Keyword" foreground="#569CD6"/>
  <RuleSet ignoreCase="true">
    <Rule color="Comment">//.*$</Rule>
    <Rule color="Comment">^\s*[;#].*$</Rule>
    <Span color="String" begin="&quot;" end="&quot;"/>
    <Rule color="Section">^\s*\[[^\]\r\n]*\]</Rule>
    <Rule color="Key">^\s*[A-Za-z_][\w\.\-]*(?=\s*[=:])</Rule>
    <Keywords color="Keyword">
      <Word>true</Word>
      <Word>false</Word>
      <Word>yes</Word>
      <Word>no</Word>
      <Word>on</Word>
      <Word>off</Word>
      <Word>null</Word>
    </Keywords>
    <Rule color="Number">\b-?\d+(\.\d+)?\b</Rule>
  </RuleSet>
</SyntaxDefinition>
